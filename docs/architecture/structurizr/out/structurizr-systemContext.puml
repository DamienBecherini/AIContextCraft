@startuml
title <size:24>System Context - AIContextCraft</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #08427b;
    LineColor: #052e56;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1168bd;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
</style>

person "==Developer\n<size:16>[Person]</size>\n\nRuns AIContextCraft from local terminal or CI." <<Element-RWxlbWVudCxQZXJzb24=>> as Developer
person "==CI Runner\n<size:16>[Person]</size>\n\nExecutes validation and automation jobs." <<Element-RWxlbWVudCxQZXJzb24=>> as CIRunner
rectangle "==Target Repository\n<size:16>[Software System]</size>\n\nCodebase scanned and filtered to produce LLM-ready context." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as TargetRepository
rectangle "==System Clipboard\n<size:16>[Software System]</size>\n\nReceives generated content when clipboard copy is enabled." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as SystemClipboard
rectangle "==Git Repository\n<size:16>[Software System]</size>\n\nProvides refs and diffs for --git-diff mode." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as GitRepository
rectangle "==Output Filesystem\n<size:16>[Software System]</size>\n\nStores generated context files and logs." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as OutputFilesystem
rectangle "==AIContextCraft\n<size:16>[Software System]</size>\n\nCLI tool that builds structured context and diff reports for LLM workflows." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as AIContextCraft

Developer --> AIContextCraft <<Relationship-UmVsYXRpb25zaGlw>> : "Runs commands and reads output"
CIRunner --> AIContextCraft <<Relationship-UmVsYXRpb25zaGlw>> : "Executes automated checks and docs generation"
AIContextCraft --> TargetRepository <<Relationship-UmVsYXRpb25zaGlw>> : "Reads files, ignore files, and project structure"
AIContextCraft --> GitRepository <<Relationship-UmVsYXRpb25zaGlw>> : "Reads refs and computes diff report in git-diff mode"
AIContextCraft --> OutputFilesystem <<Relationship-UmVsYXRpb25zaGlw>> : "Writes generated output and logs"
AIContextCraft --> SystemClipboard <<Relationship-UmVsYXRpb25zaGlw>> : "Copies generated content when enabled"

@enduml